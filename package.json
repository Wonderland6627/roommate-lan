{
  "name": "roommate",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch-bins": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-tailscale-bins.ps1",
    "dev-service": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-service.ps1",
    "package-check": "powershell -ExecutionPolicy Bypass -File ./scripts/package-check.ps1",
    "version:check": "powershell -ExecutionPolicy Bypass -File ./scripts/version.ps1 -Check",
    "version:set": "powershell -ExecutionPolicy Bypass -File ./scripts/version.ps1 -Set",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
