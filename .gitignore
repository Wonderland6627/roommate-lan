# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python (Room API local runs / smoke tests)
__pycache__/
*.py[cod]
*.sqlite3
*.sqlite3-*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri
src-tauri/target
src-tauri/gen

# Sidecar binaries (fetch via scripts/fetch-tailscale-bins.ps1)
src-tauri/binaries/*.exe
src-tauri/binaries/*.dll
!src-tauri/binaries/.gitkeep

# Secrets / local env
.env
.env.*
!.env.example
infra/.env
infra/derper/certs/*.crt
infra/derper/certs/*.key
!infra/derper/certs/.gitkeep
infra/logs/*
!infra/logs/.gitkeep
!infra/logs/traffic/
infra/logs/traffic/*
!infra/logs/traffic/.gitkeep

# Tauri updater private keys (public key lives in tauri.conf.json)
src-tauri/keys/*.key
!src-tauri/keys/.gitkeep
!src-tauri/keys/*.key.pub
!src-tauri/keys/README.md

# OS
Thumbs.db

# Accidental npm output
/src-tauri/2
