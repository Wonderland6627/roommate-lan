ROOMMATE_LOGIN_SERVER=https://hs.example.com
# Optional override; defaults to ROOMMATE_LOGIN_SERVER (Room API is served under /api on same host).
# ROOMMATE_BOOTSTRAP_URL=https://hs.example.com
# Local / private builds only. Public GitHub Releases must NOT embed a long-lived AuthKey
# (CI sets ROOMMATE_PUBLIC_RELEASE=1). Prefer create/join room in the app.
# ROOMMATE_AUTH_KEY=tskey-auth-replace-me
