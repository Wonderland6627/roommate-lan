{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roommate-LAN",
  "version": "0.5.1",
  "identifier": "com.wonderland.roommate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roommate-LAN",
        "width": 420,
        "height": 640,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/tailscale", "binaries/tailscaled"],
    "resources": ["binaries/wintun.dll", "../THIRD_PARTY_NOTICES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFOTVCNzA3QUFDQ0NEQjgKUldTNHpjeXFCN2VWamt0czlkaWRndUo2ZzhPTmthWWYwdXFHSTFFdTRoNkxEcSs2L3BiR3VPcTUK",
      "endpoints": [
        "https://github.com/Wonderland6627/roommate-lan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
