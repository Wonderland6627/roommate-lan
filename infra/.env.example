# Copy to .env and fill in real values before docker compose up.
# Do NOT commit .env with secrets.

# Public DNS names pointing at this Tencent Cloud Lighthouse IP
HS_DOMAIN=hs.example.com
DERP_DOMAIN=derp.example.com

# Email for Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# Headscale noise private key is auto-generated on first boot into the data volume.
# Optional: pin Headscale image tag
HEADSCALE_IMAGE=headscale/headscale:0.23.0

# Room API — create with: docker compose exec headscale headscale apikeys create
HEADSCALE_API_KEY=
HEADSCALE_USER=roommate
ROOM_TTL_HOURS=4
AUTHKEY_TTL_HOURS=2
# Offline Headscale node GC (seconds; 0 = disable). Default 900.
# HEADSCALE_NODE_OFFLINE_SECS=900
# Room API business logs (host path infra/logs → container /data/logs)
# LOG_DIR=/data/logs
# LOG_RETAIN_DAYS=14
# Local/dev only: skip Headscale minting (never set in production)
# MOCK_AUTH_KEY=
